{
  "id": "debug-features",
  "title": "Debug and introspection defaults",
  "seeds": [
    "(DEBUG|debug|DEVELOPMENT|TRACE)[A-Za-z_]*[[:space:]]*[:=][[:space:]]*(True|true|1)",
    "(getenv|environ\\.get|process\\.env).{0,40}(DEBUG|VERBOSE).{0,40}(or|\\|\\|)[[:space:]]*(True|true|['\"]1['\"])",
    "(getenv|environ\\.get|getOrDefault)\\([^)]*,[[:space:]]*['\"]?(true|1|on|yes|enabled)['\"]?[[:space:]]*\\)",
    "(introspection|playground|graphiql|swagger|actuator|pprof|expvar)[[:space:]]*[:=][[:space:]]*(True|true|1)",
    "(traceback\\.format_exc|format_exc|printStackTrace|getStackTrace|exc_info)",
    "['\"][^'\"]*['\"][[:space:]]*\\+[[:space:]]*[A-Za-z_][A-Za-z0-9_]*\\.getMessage\\(\\)",
    "(show_exceptions|PROPAGATE_EXCEPTIONS|display_errors|full_stack)"
  ]
}
