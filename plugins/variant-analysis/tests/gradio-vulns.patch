+def extract_video_thumbnail(video_path: str, timestamp: str = "00:00:01") -> str:
+    """Extract a still frame from an uploaded video for use as a preview thumbnail."""
+    output_path = str(Path(video_path).with_suffix(".thumb.jpg"))
+    cmd = (
+        f"ffmpeg -y -loglevel quiet -ss {timestamp} -i {video_path} "
+        f"-frames:v 1 {output_path}"
+    )
+    subprocess.run(cmd, shell=True, check=False)
+    return output_path
+
