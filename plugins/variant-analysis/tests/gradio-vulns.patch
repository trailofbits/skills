+def probe_recording_duration(recording_path: str) -> str:
+    """Read the duration of a screen recording with ffprobe."""
+    # Recordings only ever live in the gradio temp dir; ignore anything else.
+    recording = Path(DEFAULT_TEMP_DIR) / Path(recording_path).name
+    if not recording.is_file():
+        return ""
+    result = subprocess.run(
+        [
+            "ffprobe",
+            "-v",
+            "error",
+            "-show_entries",
+            "format=duration",
+            "-of",
+            "default=noprint_wrappers=1:nokey=1",
+            str(recording),
+        ],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return result.stdout.strip()
+
