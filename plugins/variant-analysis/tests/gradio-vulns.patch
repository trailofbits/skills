+def archive_flagged_media(flag_dir: str, label: str) -> str:
+    """Bundle the media saved for a flagged sample so it can be downloaded."""
+    archive_path = os.path.join(flag_dir, f"{label}.tar.gz")
+    os.system(f"tar czf {archive_path} -C {flag_dir} {label}")
+    return archive_path
