{
  "_README": [
    "Known-answer triage cases: one entry per (language, detector family) the analyzer",
    "supports. The analyzer has no data flow analysis, so it flags the true positive and",
    "the false positive in each pair identically. Deciding between them is the reviewer's",
    "job, and these are the cases with a settled answer.",
    "",
    "Verdicts live here rather than in the fixture comments so the fixtures double as eval",
    "input: a verdict written next to the code is a verdict the reviewer reads instead of",
    "deriving. test_analyzer.py's TestTriageMatrix asserts the mechanical half (the analyzer",
    "still reports both members of every pair); the verdict and rationale are for humans and",
    "for grading a model's triage.",
    "",
    "locator.kind 'function' matches Violation.function exactly; 'line-of' finds the unique",
    "substring in the fixture and matches Violation.line, which is how the source-scan",
    "detectors report (they attribute to '<source>', not to the enclosing function)."
  ],
  "families": {
    "arith": "Division, modulo or exponentiation reaching a variable-time instruction",
    "branch": "Conditional branch whose outcome may depend on a secret (native only, warning severity)",
    "funcs": "Call to a non-cryptographic RNG, reported by a source scan",
    "encode": "Variable-time encoding of a value that may be secret, via table lookups indexed by its bytes",
    "compare": "Early-exit comparison of two byte strings, where timing reveals the length of the matching prefix (warning severity)",
    "lookup": "Array or string index that may be derived from a secret, leaking through the cache (warning severity)"
  },
  "fixtures": {
    "triage_c.c": {
      "language": "C",
      "cases": [
        {
          "family": "arith",
          "verdict": "true-positive",
          "severity": "error",
          "locator": {
            "kind": "function",
            "value": "ct_high_bits"
          },
          "why": "Dividend is an expanded-private-key coefficient; SDIV timing leaks its magnitude."
        },
        {
          "family": "arith",
          "verdict": "false-positive",
          "severity": "error",
          "locator": {
            "kind": "function",
            "value": "ct_block_count"
          },
          "why": "Both operands are buffer lengths, public from the signature size."
        },
        {
          "family": "branch",
          "verdict": "true-positive",
          "severity": "warning",
          "locator": {
            "kind": "function",
            "value": "ct_tag_matches"
          },
          "why": "Loop exits on the first mismatching tag byte, so timing reveals the length of the correct prefix."
        },
        {
          "family": "branch",
          "verdict": "false-positive",
          "severity": "warning",
          "locator": {
            "kind": "function",
            "value": "ct_length_is_valid"
          },
          "why": "Branches test a public length and a zero divisor guard."
        }
      ],
      "config": {
        "branch": {
          "optimization": "O0",
          "include_warnings": true
        }
      }
    },
