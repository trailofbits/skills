        {"family": "arith", "verdict": "false-positive", "severity": "error", "locator": {"kind": "function", "value": "ct_block_count"}, "why": "Both operands are buffer lengths, public from the signature size."},
        {"family": "branch", "verdict": "true-positive", "severity": "warning", "locator": {"kind": "function", "value": "ct_tag_matches"}, "why": "Loop exits on the first mismatching tag byte, so timing reveals the length of the correct prefix."},
        {"family": "branch", "verdict": "false-positive", "severity": "warning", "locator": {"kind": "function", "value": "ct_length_is_valid"}, "why": "Branches test a public length and a zero divisor guard."}
      ],
      "config": {"branch": {"optimization": "O0", "include_warnings": true}}
    },
