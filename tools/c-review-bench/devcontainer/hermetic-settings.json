{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "c-review@trailofbits": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "directory",
        "path": "/workspace/skills-repo"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [{ "type": "command", "command": "bash /opt/guard/block-net-tool.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bash /opt/guard/block-net-bash.sh" }]
      }
    ]
  }
}
